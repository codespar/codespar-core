          }
        },
        "required": [
          "id"
        ]
      }
    },
    {
      "name": "cancel_nfce",
      "input_schema": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "description": "NFC-e ID"
          },
          "justificativa": {
            "type": "string",
            "description": "Cancellation reason (min 15 chars)"
          }
        },
        "required": [
