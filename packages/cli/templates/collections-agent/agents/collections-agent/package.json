{
  "name": "@codespar/collections-agent",
  "version": "0.1.0",
  "private": true,
  "description": "The merchant's agent that collects: agrees terms with the payer inside a negotiation envelope, issues one bolepix per instalment with an idempotency key, presents the QR and the copy-and-paste in the conversation, and closes the cycle on commerce.charge.paid or commerce.charge.expired.",
  "license": "MIT",
  "type": "module",
  "scripts": {
    "start": "node --disable-warning=ExperimentalWarning --import tsx src/main.ts",
    "check": "node --disable-warning=ExperimentalWarning --import tsx src/commands/check.ts",
    "eval": "node --disable-warning=ExperimentalWarning --import tsx src/commands/eval.ts",
    "resume": "node --disable-warning=ExperimentalWarning --import tsx src/commands/resume.ts",
    "rerun": "node --disable-warning=ExperimentalWarning --import tsx src/commands/rerun.ts",
    "reconcile": "node --disable-warning=ExperimentalWarning --import tsx src/commands/reconcile.ts",
    "poll": "node --disable-warning=ExperimentalWarning --import tsx src/commands/poll.ts",
    "webhook": "node --disable-warning=ExperimentalWarning --import tsx src/commands/webhook.ts",
    "approve": "node --disable-warning=ExperimentalWarning --import tsx src/commands/approve.ts",
    "deny": "node --disable-warning=ExperimentalWarning --import tsx src/commands/deny.ts",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "vitest run --pool=forks --maxWorkers=1 --root ../.. agents/collections-agent"
  },
  "dependencies": {
    "@codespar/agent-core": "0.1.0",
    "qrcode-terminal": "0.12.0"
  },
  "devDependencies": {
    "@types/qrcode-terminal": "0.12.2"
  }
}
