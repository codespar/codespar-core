{
  "name": "@codespar/collections-agent",
  "version": "0.1.0",
  "private": true,
  "description": "The merchant's agent that collects: agrees terms with the payer inside a negotiation envelope, issues one bolepix per instalment with an idempotency key, presents the QR and the copy-and-paste in the conversation, and closes the cycle on commerce.charge.paid or commerce.charge.expired.",
  "license": "MIT",
  "type": "module",
  "scripts": {
    "start": "codespar-agent start",
    "check": "codespar-agent check",
    "inspect": "codespar-agent inspect",
    "eval": "codespar-agent eval",
    "resume": "codespar-agent resume",
    "rerun": "codespar-agent rerun",
    "reconcile": "codespar-agent reconcile",
    "poll": "codespar-agent poll",
    "webhook": "codespar-agent webhook",
    "approve": "codespar-agent approve",
    "deny": "codespar-agent deny",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "vitest run --pool=forks --maxWorkers=1 --root ../.. agents/collections-agent"
  },
  "dependencies": {
    "@codespar/agent-core": "0.1.0",
    "@codespar/agent-runtime": "0.1.0",
    "qrcode-terminal": "0.12.0"
  },
  "devDependencies": {
    "@types/qrcode-terminal": "0.12.2"
  }
}
