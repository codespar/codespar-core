# Copy to agents/collections-agent/.env. `npm install` runs at the repository ROOT (npm workspace), then `npm start`.
# Test key from https://codespar.dev/auth/signup (starts with csk_test_). A live key is refused.
CODESPAR_API_KEY=csk_test_your_key_here
# https://console.anthropic.com. Leave empty to replay the recorded happy path (the old placeholder sk-ant-your_key_here also counts as empty).
ANTHROPIC_API_KEY=
# Staging only (docs/OPEN_QUESTIONS.md, item 12): a staging test key also needs the staging base URL. A production key needs nothing here. The CodeSpar CLI calls the same setting CODESPAR_BASE_URL (and the project CODESPAR_PROJECT, here CODESPAR_PROJECT_ID): the kit reads either name, and a command that talks to the API refuses to start if the two disagree. A CLI login kept in ~/.codespar/config.json is not read by the kit: only the environment and this file are.
# CODESPAR_API_URL=https://api.staging.codespar.dev

# --- WhatsApp, the official Cloud API backend. Commented out and empty on purpose. ---
# The default backend needs NONE of these: it talks to a local Cloud API emulator
# (`npm run whatsapp:emulator` at the repo root), with no Meta account and nothing
# leaving the machine. Uncomment these only if you have your own Meta Business
# account and want `--backend cloud-api`, which is the same code pointed at
# graph.facebook.com. This repo has never run one; the shapes are written from
# Meta's published documentation. Nothing in the tests or the CI reads them.
# WHATSAPP_PHONE_NUMBER_ID=
# WHATSAPP_ACCESS_TOKEN=
# WHATSAPP_VERIFY_TOKEN=
# WHATSAPP_APP_SECRET=
# WHATSAPP_API_VERSION=v21.0
# WHATSAPP_WEBHOOK_PORT=3111
