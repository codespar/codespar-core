# Copy to agents/hello-agent/.env. `npm install` runs at the repository ROOT (npm workspace), then `npm start`.
# This agent reads and pays nothing, so it needs no key at all; the file exists because every agent declares the same two.
CODESPAR_API_KEY=csk_test_your_key_here
# https://console.anthropic.com. Leave empty to replay the recorded conversation.
ANTHROPIC_API_KEY=
