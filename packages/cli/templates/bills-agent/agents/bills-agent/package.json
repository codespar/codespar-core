{
  "name": "@codespar/bills-agent",
  "version": "0.1.0",
  "private": true,
  "description": "The consumer delegates the month's bills to an agent that pays under a signed mandate: per-payment cap, monthly cap, named payees, expiry. Every payment returns a receipt.",
  "license": "MIT",
  "type": "module",
  "scripts": {
    "start": "codespar-agent start",
    "check": "codespar-agent check",
    "inspect": "codespar-agent inspect",
    "verify": "codespar-agent verify",
    "eval": "codespar-agent eval",
    "resume": "codespar-agent resume",
    "rerun": "codespar-agent rerun",
    "reconcile": "codespar-agent reconcile",
    "consent": "codespar-agent consent",
    "approve": "codespar-agent approve",
    "deny": "codespar-agent deny",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "vitest run --pool=forks --maxWorkers=1 --root ../.. agents/bills-agent"
  },
  "dependencies": {
    "@codespar/agent-core": "0.1.0",
    "@codespar/agent-runtime": "0.1.0"
  }
}
