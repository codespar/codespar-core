# Test key from https://dashboard.codespar.dev (starts with csk_test_). A live key is refused.
# Staging: also set CODESPAR_API_URL=https://api.staging.codespar.dev in your shell (not here).
CODESPAR_API_KEY=csk_test_your_key_here
# https://console.anthropic.com. Without it, `npm start -- --input ...` replays the recorded scenario whose first turn you typed.
ANTHROPIC_API_KEY=sk-ant-your_key_here
